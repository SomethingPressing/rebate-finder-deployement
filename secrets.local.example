# Copy this file to secrets.local and fill in your values.
# secrets.local is gitignored — never commit it.
#
# Usage:
#   source secrets.local && bash scripts/provision.sh
#   — or —
#   bash provision-client.sh

# ── Required ──────────────────────────────────────────────────────────────────
DO_API_TOKEN=dop_v1_...           # cloud.digitalocean.com/account/api/tokens
GITHUB_PAT=ghp_...                # github.com/settings/tokens  (repo scope)
OPENAI_API_KEY=sk-...             # platform.openai.com/api-keys

# ── Client ────────────────────────────────────────────────────────────────────
APP_DOMAIN=client.incenva.com     # omit to use raw IP
ADMIN_EMAIL=admin@client.com
ADMIN_PASSWORD=SecurePass123!
ADMIN_NAME="Admin User"

# ── Fly.io scraper — delete this block to skip scraper setup ─────────────────
FLY_API_TOKEN=fo1_...             # fly.io/user/personal_access_tokens
# REWIRING_AMERICA_API_KEY=...
# SCRAPER_REPO_DIR=~/workspace/rebate-finder-scrapers

# ── Server config — defaults are fine for most deployments ───────────────────
# DO_REGION=nyc1
# DO_SIZE=s-1vcpu-2gb-70gb-intel
# DO_SSH_KEY_IDS=12345678         # your DO SSH key ID for direct server access
